{
  "name": "@onozaty/redmine-mcp-server",
  "version": "1.1.3",
  "description": "MCP server for Redmine",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "bin": {
    "redmine-mcp-server": "./dist/server.mjs"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "gen": "cmd /c \"if exist src\\__generated__ rd /s /q src\\__generated__\" && orval && node post-generate.js",
    "build": "pnpm gen && tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onozaty/redmine-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "redmine"
  ],
  "author": "onozaty",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/onozaty/redmine-mcp-server/issues"
  },
  "homepage": "https://github.com/onozaty/redmine-mcp-server#readme",
  "devDependencies": {
    "@types/node": "^25.0.9",
    "orval": "^8.0.2",
    "tsdown": "^0.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.3",
    "zod": "^4.3.5"
  }
}